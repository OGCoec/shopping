            </ConstantTimer>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Assert And Record Card Secrets" enabled="true">
              <stringProp name="cacheKey">order-soft-close-assert-card-secrets</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script"><![CDATA[
import groovy.json.JsonSlurper
import java.nio.charset.StandardCharsets
import java.nio.file.Files
import java.nio.file.Path
import java.nio.file.StandardOpenOption

def intValue = { Object value, int fallback ->
    if (value == null) {
        return fallback
    }
    try {
        return Integer.parseInt(value.toString())
    } catch (Throwable ignored) {
        return fallback
    }
}

def csvValue = { Object value ->
    def text = value == null ? '' : value.toString()
    if (text.contains('"') || text.contains(',') || text.contains('\n') || text.contains('\r')) {
        return '"' + text.replace('"', '""') + '"'
    }
    return text
}

def expectedPaidScenarios = ['PAY_NOW', 'CLOSING_CALLBACK', 'BOUNDARY_DELAYED_CALLBACK'] as Set
def scenario = vars.get('paymentScenario') ?: ''
def expectedPaid = expectedPaidScenarios.contains(scenario)
def expectedQuantity = intValue(vars.get('quantity'), 0)

def businessCode = ''
def deliveryStatus = ''
def requiredCount = 0
def deliveredCount = 0
def secretCount = 0
try {
    def body = prev.getResponseDataAsString()
    if (body != null && !body.isBlank()) {
        def json = new JsonSlurper().parseText(body)
        businessCode = (json.code ?: '').toString()
        if (json.data != null) {
            deliveryStatus = (json.data.deliveryStatus ?: '').toString()
            requiredCount = intValue(json.data.requiredCount, 0)
            deliveredCount = intValue(json.data.deliveredCount, 0)
            def items = json.data.items
            if (items instanceof Collection) {
                items.each { item ->
                    def secrets = item?.secrets
                    if (secrets instanceof Collection) {
                        secretCount += secrets.size()
                    }
                }
            }
        }
    }
} catch (Throwable ignored) {
}

def headers = (prev.getResponseHeaders() ?: '').toLowerCase()
def cacheControlNoStore = headers.readLines().any { line ->
    line.startsWith('cache-control:') && line.contains('no-store')
}

def ok = expectedPaid
        ? (businessCode == 'ORDER_CARD_SECRET_LIST_OK'
                && deliveredCount == expectedQuantity
                && secretCount == expectedQuantity
                && cacheControlNoStore)
        : (businessCode != 'ORDER_CARD_SECRET_LIST_OK' && secretCount == 0)

def message = prev.getResponseMessage() ?: ''
message += ' businessCode=' + businessCode
message += ' orderNo=' + vars.get('orderNo')
message += ' paymentScenario=' + scenario
message += ' expectedPaid=' + expectedPaid
message += ' requiredCount=' + requiredCount
message += ' deliveredCount=' + deliveredCount
message += ' secretCount=' + secretCount
message += ' cacheControlNoStore=' + cacheControlNoStore
prev.setResponseMessage(message)
prev.setSuccessful(ok)

def output = (props.getProperty('ORDER_CARD_SECRET_RESULT_CSV', '') ?: '').trim()
if (output) {
    synchronized (props) {
        def path = Path.of(output)
        def parent = path.getParent()
        if (parent != null) {
            Files.createDirectories(parent)
        }
        if (!Files.exists(path) || Files.size(path) == 0L) {
            Files.writeString(path, 'run_id,user_id,sku_id,quantity,order_no,success_index,payment_scenario,expected_paid,http_code,business_code,delivery_status,required_count,delivered_count,secret_count,cache_control_no_store,query_started_at_ms,elapsed_ms,success' + System.lineSeparator(), StandardCharsets.UTF_8, StandardOpenOption.CREATE, StandardOpenOption.APPEND)
        }
        def line = [
                props.getProperty('RUN_ID', 'local'),
                vars.get('userId'),
                vars.get('skuId'),
                vars.get('quantity'),
                vars.get('orderNo'),
                vars.get('successIndex'),
                scenario,
                expectedPaid,
                prev.getResponseCode(),
                businessCode,
                deliveryStatus,
                requiredCount,
                deliveredCount,
                secretCount,
                cacheControlNoStore,
                prev.getStartTime(),
                prev.getTime(),
                ok
        ].collect(csvValue).join(',') + System.lineSeparator()
        Files.writeString(path, line, StandardCharsets.UTF_8, StandardOpenOption.CREATE, StandardOpenOption.APPEND)
    }
}
]]></stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
          </hashTree>
        </hashTree>
