        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST Create Order" enabled="true">
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{
  "skuId": "${skuId}",
  "quantity": ${quantity},
  "idempotencyKey": "order-soft-close-${__P(RUN_ID,local)}-${userId}-${__threadNum}"
}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
          <stringProp name="HTTPSampler.domain">${__P(HOST,localhost)}</stringProp>
          <stringProp name="HTTPSampler.port">${__P(PORT,6655)}</stringProp>
          <stringProp name="HTTPSampler.protocol">${__P(PROTOCOL,https)}</stringProp>
          <stringProp name="HTTPSampler.path">/shopping/user/api/orders</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
          <stringProp name="HTTPSampler.embedded_url_re"></stringProp>
          <stringProp name="HTTPSampler.connect_timeout"></stringProp>
          <stringProp name="HTTPSampler.response_timeout"></stringProp>
        </HTTPSamplerProxy>
        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Prepare Random Quantity" enabled="true">
            <stringProp name="cacheKey">order-soft-close-prepare-quantity</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script"><![CDATA[
import java.util.concurrent.ThreadLocalRandom

vars.put('createStartedAtMs', String.valueOf(System.currentTimeMillis()))
vars.put('quantity', String.valueOf(ThreadLocalRandom.current().nextInt(1, 6)))
vars.put('businessCode', '')
vars.put('orderNo', '')
vars.put('orderStatus', '')
vars.put('expireAt', '')
vars.put('expireAtEpochMs', '')
vars.put('payAmountYuan', '0')
vars.put('callbackPaidAmountYuan', '1.00')
vars.put('successIndex', '')
vars.put('paymentScenario', 'NO_ORDER')
vars.put('payNowDelayMs', '0')
vars.put('closingCallbackTargetMs', '')
vars.put('boundaryRecordTargetMs', '')
vars.put('closedCallbackTargetMs', '')
]]></stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Capture Create Result And Assign Scenario" enabled="true">
            <stringProp name="cacheKey">order-soft-close-capture-create</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script"><![CDATA[
import groovy.json.JsonSlurper
import java.nio.charset.StandardCharsets
import java.nio.file.Files
import java.nio.file.Path
import java.nio.file.StandardOpenOption
import java.time.OffsetDateTime
import java.util.concurrent.ThreadLocalRandom
import java.util.concurrent.atomic.AtomicInteger

def intProp = { String name, int fallback ->
    try {
        return Integer.parseInt(props.getProperty(name, String.valueOf(fallback)))
    } catch (Throwable ignored) {
        return fallback
    }
}

def longProp = { String name, long fallback ->
    try {
        return Long.parseLong(props.getProperty(name, String.valueOf(fallback)))
    } catch (Throwable ignored) {
        return fallback
    }
}

def successCounter = props.get('ORDER_SOFT_CLOSE_SUCCESS_COUNTER')
if (successCounter == null) {
    synchronized (props) {
        successCounter = props.get('ORDER_SOFT_CLOSE_SUCCESS_COUNTER')
        if (successCounter == null) {
            successCounter = new AtomicInteger(0)
            props.put('ORDER_SOFT_CLOSE_SUCCESS_COUNTER', successCounter)
        }
    }
}

def businessCode = ''
def orderNo = ''
def orderStatus = ''
def expireAt = ''
def expireAtEpochMs = ''
def payAmountYuan = '0'
def callbackPaidAmountYuan = '1.00'
try {
    def body = prev.getResponseDataAsString()
    if (body != null && !body.isBlank()) {
        def json = new JsonSlurper().parseText(body)
        businessCode = (json.code ?: '').toString()
        if (json.data != null) {
            orderNo = (json.data.orderNo ?: '').toString()
            orderStatus = (json.data.status ?: '').toString()
            expireAt = (json.data.expireAt ?: '').toString()
            payAmountYuan = (json.data.payAmountYuan ?: '0').toString()
            try {
                def parsedAmount = new BigDecimal(payAmountYuan)
                if (parsedAmount.compareTo(BigDecimal.ZERO) > 0) {
                    callbackPaidAmountYuan = payAmountYuan
                }
            } catch (Throwable ignored) {
            }
            if (expireAt) {
                try {
                    expireAtEpochMs = String.valueOf(OffsetDateTime.parse(expireAt).toInstant().toEpochMilli())
                } catch (Throwable ignored) {
                }
            }
        }
    }
} catch (Throwable ignored) {
}

vars.put('businessCode', businessCode)
vars.put('orderNo', orderNo)
vars.put('orderStatus', orderStatus)
vars.put('expireAt', expireAt)
vars.put('expireAtEpochMs', expireAtEpochMs)
vars.put('payAmountYuan', payAmountYuan)
vars.put('callbackPaidAmountYuan', callbackPaidAmountYuan)

def paymentScenario = 'NO_ORDER'
def successIndex = ''
if (businessCode == 'ORDER_CREATE_OK' && orderNo) {
    def index = successCounter.incrementAndGet()
    successIndex = String.valueOf(index)
    def payNowCount = intProp('PAY_NOW_COUNT', 4)
    def closingCallbackCount = intProp('CLOSING_CALLBACK_COUNT', 4)
    def closingUserPayNegativeCount = intProp('CLOSING_USER_PAY_NEGATIVE_COUNT', 4)
    def closedCallbackNegativeCount = intProp('CLOSED_CALLBACK_NEGATIVE_COUNT', 4)
    if (index <= payNowCount) {
        paymentScenario = 'PAY_NOW'
    } else if (index <= payNowCount + closingCallbackCount) {
        paymentScenario = 'CLOSING_CALLBACK'
    } else if (index <= payNowCount + closingCallbackCount + closingUserPayNegativeCount) {
        paymentScenario = 'CLOSING_USER_PAY_NEGATIVE'
    } else if (index <= payNowCount + closingCallbackCount + closingUserPayNegativeCount + closedCallbackNegativeCount) {
        paymentScenario = 'CLOSED_CALLBACK_NEGATIVE'
    } else {
        paymentScenario = 'BOUNDARY_DELAYED_CALLBACK'
    }

    def minDelay = Math.max(0, intProp('PAY_NOW_MIN_DELAY_SECONDS', 5))
    def maxDelay = Math.max(minDelay, intProp('PAY_NOW_MAX_DELAY_SECONDS', 30))
    vars.put('payNowDelayMs', String.valueOf(ThreadLocalRandom.current().nextLong(minDelay, maxDelay + 1L) * 1000L))

    def paymentExpireTtlSeconds = longProp('PAYMENT_EXPIRE_TTL_SECONDS', 300L)
    def boundaryRecordDelaySeconds = longProp('BOUNDARY_RECORD_DELAY_SECONDS', 299L)
    def closingCallbackDelaySeconds = longProp('CLOSING_CALLBACK_DELAY_SECONDS', 305L)
    def closedCallbackDelaySeconds = longProp('CLOSED_CALLBACK_DELAY_SECONDS', 610L)
    def expireBaseMs = 0L
    try {
        expireBaseMs = expireAtEpochMs ? Long.parseLong(expireAtEpochMs) : 0L
    } catch (Throwable ignored) {
    }
    if (expireBaseMs <= 0L) {
        expireBaseMs = Long.parseLong(vars.get('createStartedAtMs')) + paymentExpireTtlSeconds * 1000L
    }
    def boundaryBeforeExpireSeconds = Math.max(0L, paymentExpireTtlSeconds - boundaryRecordDelaySeconds)
    def closingAfterExpireSeconds = Math.max(0L, closingCallbackDelaySeconds - paymentExpireTtlSeconds)
    def closedAfterExpireSeconds = Math.max(0L, closedCallbackDelaySeconds - paymentExpireTtlSeconds)
    vars.put('boundaryRecordTargetMs', String.valueOf(Math.max(0L, expireBaseMs - boundaryBeforeExpireSeconds * 1000L)))
    vars.put('closingCallbackTargetMs', String.valueOf(expireBaseMs + closingAfterExpireSeconds * 1000L))
    vars.put('closedCallbackTargetMs', String.valueOf(expireBaseMs + closedAfterExpireSeconds * 1000L))
}

vars.put('successIndex', successIndex)
vars.put('paymentScenario', paymentScenario)

def message = prev.getResponseMessage() ?: ''
if (businessCode) {
    message += ' businessCode=' + businessCode
}
if (orderNo) {
    message += ' orderNo=' + orderNo
}
if (orderStatus) {
    message += ' orderStatus=' + orderStatus
}
if (expireAt) {
    message += ' expireAt=' + expireAt
}
if (successIndex) {
    message += ' successIndex=' + successIndex
}
if (paymentScenario) {
    message += ' paymentScenario=' + paymentScenario
}
message += ' quantity=' + vars.get('quantity')
prev.setResponseMessage(message)

def expectedCodes = ['ORDER_CREATE_OK', 'ORDER_STOCK_NOT_ENOUGH', 'ORDER_ALREADY_CREATED'] as Set
prev.setSuccessful(expectedCodes.contains(businessCode))

if (businessCode == 'ORDER_CREATE_OK' && orderNo) {
    def csvPath = (props.getProperty('ORDER_SUCCESS_CSV', '') ?: '').trim()
    if (csvPath) {
        synchronized (props) {
            def path = Path.of(csvPath)
            def parent = path.getParent()
            if (parent != null) {
                Files.createDirectories(parent)
            }
            if (!Files.exists(path) || Files.size(path) == 0L) {
                Files.writeString(path, 'runId,userId,skuId,quantity,orderNo,orderStatus,successIndex,paymentScenario,businessCode,createStartedAtMs,expireAt,expireAtEpochMs,boundaryRecordTargetMs,closingCallbackTargetMs,closedCallbackTargetMs' + System.lineSeparator(), StandardCharsets.UTF_8, StandardOpenOption.CREATE, StandardOpenOption.APPEND)
            }
            def line = [
                    props.getProperty('RUN_ID', 'local'),
                    vars.get('userId'),
                    vars.get('skuId'),
                    vars.get('quantity'),
                    orderNo,
                    orderStatus,
                    successIndex,
                    paymentScenario,
                    businessCode,
                    vars.get('createStartedAtMs'),
                    vars.get('expireAt'),
                    vars.get('expireAtEpochMs'),
                    vars.get('boundaryRecordTargetMs'),
                    vars.get('closingCallbackTargetMs'),
                    vars.get('closedCallbackTargetMs')
            ].join(',') + System.lineSeparator()
            Files.writeString(path, line, StandardCharsets.UTF_8, StandardOpenOption.CREATE, StandardOpenOption.APPEND)
        }
    }
}
]]></stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>
        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="Scenario Pay Now" enabled="true">
          <stringProp name="IfController.condition">${__groovy(vars.get('paymentScenario') == 'PAY_NOW')}</stringProp>
          <boolProp name="IfController.evaluateAll">false</boolProp>
          <boolProp name="IfController.useExpression">true</boolProp>
        </IfController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST Pay Now" enabled="true">
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
              <collectionProp name="Arguments.arguments">
