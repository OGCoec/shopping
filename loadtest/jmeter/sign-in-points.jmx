        <hashTree>
          <JSR223Timer guiclass="TestBeanGUI" testclass="JSR223Timer" testname="Next Sign-In Second Boundary" enabled="true">
            <stringProp name="cacheKey">sign-in-continuous-second-boundary</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script"><![CDATA[
long offsetMs = ((props.get('CONTINUOUS_BOUNDARY_OFFSET_MS') ?: '120') as String) as long
Long nextSecond = vars.getObject('continuousNextSecond') as Long
long nowMs = System.currentTimeMillis()
if (nextSecond == null) {
    nextSecond = Math.floorDiv(nowMs, 1000L) + 1L
}
long targetMs = nextSecond * 1000L + offsetMs
long sleepMs = targetMs - nowMs
if (sleepMs > 0L) {
    Thread.sleep(sleepMs)
}
vars.putObject('continuousNextSecond', nextSecond + 1L)
]]></stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223Timer>
          <hashTree/>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Continuous Sequence" enabled="true">
            <stringProp name="cacheKey">sign-in-continuous-sequence</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script"><![CDATA[
def next = ((vars.get('continuousSeq') ?: '0') as int) + 1
vars.put('continuousSeq', next.toString())
]]></stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Capture Sign In Response" enabled="true">
            <stringProp name="cacheKey">sign-in-capture-continuous</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script"><![CDATA[
try {
    def json = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString() ?: '{}')
    def code = (json.code ?: '').toString()
    vars.put('businessCode', code)
    prev.setResponseMessage((prev.getResponseMessage() ?: '') +
            " businessCode=${code}" +
            " rewardPoints=${json.rewardPoints}" +
            " continuousCount=${json.continuousCount}" +
            " cycleDay=${json.cycleDay}" +
            " seq=${vars.get('continuousSeq')}")
} catch (Throwable ignored) {
}
]]></stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Continuous Reward Assertion" enabled="true">
            <stringProp name="cacheKey">sign-in-continuous-assertion</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script"><![CDATA[
def fail = { msg ->
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(msg.toString())
}

if ((prev.getResponseCode() ?: '') != '200') {
    fail("Expected HTTP 200 but got ${prev.getResponseCode()}, seq=${vars.get('continuousSeq')}")
    return
}

def json
try {
    json = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString() ?: '{}')
} catch (Throwable e) {
    fail("Response is not valid JSON, seq=${vars.get('continuousSeq')}: ${e.message}")
    return
}

def seq = (vars.get('continuousSeq') ?: '0') as int
if (json.success != true || json.code != 'SIGN_IN_OK') {
    fail("Expected SIGN_IN_OK success at seq=${seq}, body=${prev.getResponseDataAsString()}")
    return
}

def expected = [
        1 : [reward: 1, continuous: 1, cycle: 1],
        3 : [reward: 3, continuous: 3, cycle: 3],
        7 : [reward: 10, continuous: 7, cycle: 7],
        30: [reward: 50, continuous: 30, cycle: 30],
        31: [reward: 1, continuous: 31, cycle: 1],
        32: [reward: 1, continuous: 32, cycle: 2],
        33: [reward: 3, continuous: 33, cycle: 3]
]
def row = expected[seq]
if (row == null) {
    return
}
if ((json.rewardPoints as int) != row.reward ||
        (json.continuousCount as int) != row.continuous ||
        (json.cycleDay as int) != row.cycle) {
    fail("Unexpected milestone at seq=${seq}. expected=${row}, body=${prev.getResponseDataAsString()}")
}
]]></stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223Assertion>
          <hashTree/>
        </hashTree>
      </hashTree>
