<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Sign In Points Test Plan" enabled="true">
      <stringProp name="TestPlan.comments">Covers day-level duplicate clicks, same-day concurrent idempotency, and different-user same-day sign-in.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
    </TestPlan>
    <hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Same-Day Repeat User 2" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">${__P(REPEAT_LOOPS,2)}</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">1</stringProp>
        <stringProp name="ThreadGroup.ramp_time">1</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <stringProp name="ThreadGroup.duration"></stringProp>
        <stringProp name="ThreadGroup.delay"></stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
      </ThreadGroup>
      <hashTree>
        <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="Repeat User Token CSV" enabled="true">
          <stringProp name="delimiter">,</stringProp>
          <stringProp name="fileEncoding">UTF-8</stringProp>
          <stringProp name="filename">${__P(TOKEN_CSV_REPEAT,loadtest-output/sign-in-user-2-token.csv)}</stringProp>
          <boolProp name="ignoreFirstLine">true</boolProp>
          <boolProp name="quotedData">true</boolProp>
          <boolProp name="recycle">true</boolProp>
          <stringProp name="shareMode">shareMode.currentThread</stringProp>
          <boolProp name="stopThread">false</boolProp>
          <stringProp name="variableNames">userId,accessToken</stringProp>
        </CSVDataSet>
        <hashTree/>
        <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Headers" enabled="true">
          <collectionProp name="HeaderManager.headers">
            <elementProp name="" elementType="Header">
              <stringProp name="Header.name">Authorization</stringProp>
              <stringProp name="Header.value">Bearer ${accessToken}</stringProp>
            </elementProp>
            <elementProp name="" elementType="Header">
              <stringProp name="Header.name">Accept</stringProp>
              <stringProp name="Header.value">application/json</stringProp>
            </elementProp>
            <elementProp name="" elementType="Header">
              <stringProp name="Header.name">Content-Type</stringProp>
              <stringProp name="Header.value">application/json</stringProp>
            </elementProp>
          </collectionProp>
        </HeaderManager>
        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Repeat POST Sign In" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
          <stringProp name="HTTPSampler.domain">${__P(HOST,127.0.0.1)}</stringProp>
          <stringProp name="HTTPSampler.port">${__P(PORT,6655)}</stringProp>
          <stringProp name="HTTPSampler.protocol">${__P(PROTOCOL,https)}</stringProp>
          <stringProp name="HTTPSampler.path">/shopping/user/api/sign-in</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
          <stringProp name="HTTPSampler.embedded_url_re"></stringProp>
          <stringProp name="HTTPSampler.connect_timeout">${__P(CONNECT_TIMEOUT,)}</stringProp>
          <stringProp name="HTTPSampler.response_timeout">${__P(RESPONSE_TIMEOUT,)}</stringProp>
        </HTTPSamplerProxy>
        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Repeat Sequence" enabled="true">
            <stringProp name="cacheKey">sign-in-repeat-sequence</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script"><![CDATA[
def next = ((vars.get('repeatSeq') ?: '0') as int) + 1
vars.put('repeatSeq', next.toString())
]]></stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Capture Repeat Response" enabled="true">
            <stringProp name="cacheKey">sign-in-capture-repeat</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script"><![CDATA[
try {
    def json = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString() ?: '{}')
    def code = (json.code ?: '').toString()
    vars.put('businessCode', code)
    prev.setResponseMessage((prev.getResponseMessage() ?: '') +
            " businessCode=${code}" +
            " rewardPoints=${json.rewardPoints}" +
            " continuousCount=${json.continuousCount}" +
            " cycleDay=${json.cycleDay}" +
            " seq=${vars.get('repeatSeq')}")
} catch (Throwable ignored) {
}
]]></stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Repeat Same-Day Assertion" enabled="true">
            <stringProp name="cacheKey">sign-in-repeat-assertion</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script"><![CDATA[
def fail = { msg ->
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(msg.toString())
}

if ((prev.getResponseCode() ?: '') != '200') {
    fail("Expected HTTP 200 but got ${prev.getResponseCode()}, seq=${vars.get('repeatSeq')}")
    return
}

def json
try {
    json = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString() ?: '{}')
} catch (Throwable e) {
    fail("Response is not valid JSON, seq=${vars.get('repeatSeq')}: ${e.message}")
    return
}

def seq = (vars.get('repeatSeq') ?: '0') as int
if (seq == 1) {
    if (json.success != true || json.code != 'SIGN_IN_OK' ||
            (json.rewardPoints as int) != 1 ||
            (json.continuousCount as int) != 1 ||
            (json.cycleDay as int) != 1) {
        fail("Unexpected first same-day sign-in response: ${prev.getResponseDataAsString()}")
    }
    return
}

if (json.success != true || json.code != 'SIGN_IN_ALREADY_DONE' ||
        (json.rewardPoints as int) != 0 ||
        (json.continuousCount as int) != 1 ||
        (json.cycleDay as int) != 1) {
    fail("Duplicate same-day sign-in must be idempotent, seq=${seq}, body=${prev.getResponseDataAsString()}")
}
]]></stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223Assertion>
          <hashTree/>
        </hashTree>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Different Same-Day User 3" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
