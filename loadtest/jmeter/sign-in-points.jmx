        <hashTree>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Capture Other User Response" enabled="true">
            <stringProp name="cacheKey">sign-in-capture-other</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script"><![CDATA[
try {
    def json = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString() ?: '{}')
    def code = (json.code ?: '').toString()
    vars.put('businessCode', code)
    prev.setResponseMessage((prev.getResponseMessage() ?: '') +
            " businessCode=${code}" +
            " rewardPoints=${json.rewardPoints}" +
            " continuousCount=${json.continuousCount}" +
            " cycleDay=${json.cycleDay}")
} catch (Throwable ignored) {
}
]]></stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Other User Same-Day Assertion" enabled="true">
            <stringProp name="cacheKey">sign-in-other-assertion</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script"><![CDATA[
def fail = { msg ->
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(msg.toString())
}
if ((prev.getResponseCode() ?: '') != '200') {
    fail("Expected HTTP 200 but got ${prev.getResponseCode()}")
    return
}
def json = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString() ?: '{}')
if (json.success != true || json.code != 'SIGN_IN_OK' ||
        (json.rewardPoints as int) != 1 ||
        (json.continuousCount as int) != 1 ||
        (json.cycleDay as int) != 1) {
    fail("Unexpected other-user same-day response: ${prev.getResponseDataAsString()}")
}
]]></stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223Assertion>
          <hashTree/>
        </hashTree>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Same-Day Concurrent User 1" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">${__P(CONCURRENT_THREADS,50)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(CONCURRENT_RAMP_UP,1)}</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <stringProp name="ThreadGroup.duration"></stringProp>
        <stringProp name="ThreadGroup.delay"></stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
      </ThreadGroup>
      <hashTree>
