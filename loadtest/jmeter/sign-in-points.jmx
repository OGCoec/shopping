}
def code = (json.code ?: '').toString()
if (json.success != true || !(code in ['SIGN_IN_OK', 'SIGN_IN_ALREADY_DONE'])) {
    fail("Unexpected concurrent sign-in response: ${prev.getResponseDataAsString()}")
    return
}
if (code == 'SIGN_IN_ALREADY_DONE' && (json.rewardPoints as int) != 0) {
    fail("Duplicate sign-in must not grant points: ${prev.getResponseDataAsString()}")
}
]]></stringProp>
