        <hashTree>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Capture Concurrent Response" enabled="true">
            <stringProp name="cacheKey">sign-in-capture-concurrent</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script"><![CDATA[
try {
    def json = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString() ?: '{}')
    def code = (json.code ?: '').toString()
    vars.put('businessCode', code)
    prev.setResponseMessage((prev.getResponseMessage() ?: '') +
            " businessCode=${code}" +
            " rewardPoints=${json.rewardPoints}" +
            " continuousCount=${json.continuousCount}" +
            " cycleDay=${json.cycleDay}")
} catch (Throwable ignored) {
}
]]></stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Concurrent Idempotency Response Assertion" enabled="true">
            <stringProp name="cacheKey">sign-in-concurrent-assertion</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script"><![CDATA[
def fail = { msg ->
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(msg.toString())
}
if ((prev.getResponseCode() ?: '') != '200') {
    fail("Expected HTTP 200 but got ${prev.getResponseCode()}")
    return
}
def json
try {
    json = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString() ?: '{}')
} catch (Throwable e) {
    fail("Response is not valid JSON: ${e.message}")
    return
}
def code = (json.code ?: '').toString()
if (json.success != true || !(code in ['SIGN_IN_OK', 'SIGN_IN_ALREADY_DONE'])) {
    fail("Unexpected concurrent sign-in response: ${prev.getResponseDataAsString()}")
    return
}
if (code == 'SIGN_IN_ALREADY_DONE' && (json.rewardPoints as int) != 0) {
    fail("Duplicate sign-in must not grant points: ${prev.getResponseDataAsString()}")
}
]]></stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223Assertion>
          <hashTree/>
        </hashTree>
