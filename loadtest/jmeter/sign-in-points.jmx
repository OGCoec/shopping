        <JSR223Timer guiclass="TestBeanGUI" testclass="JSR223Timer" testname="Concurrent Sign-In Second Boundary" enabled="true">
          <stringProp name="cacheKey">sign-in-concurrent-second-boundary</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script"><![CDATA[
long offsetMs = ((props.get('CONCURRENT_BOUNDARY_OFFSET_MS') ?: '80') as String) as long
String key = 'signInConcurrentTargetSecond'
Long targetSecond = props.get(key) as Long
if (targetSecond == null) {
    synchronized (props) {
        targetSecond = props.get(key) as Long
        if (targetSecond == null) {
            targetSecond = Math.floorDiv(System.currentTimeMillis(), 1000L) + 2L
            props.put(key, targetSecond)
        }
    }
}
long targetMs = targetSecond * 1000L + offsetMs
long sleepMs = targetMs - System.currentTimeMillis()
if (sleepMs > 0L) {
    Thread.sleep(sleepMs)
}
]]></stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Timer>
