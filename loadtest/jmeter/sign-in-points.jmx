    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Sign In Points Test Plan" enabled="true">
      <stringProp name="TestPlan.comments">Covers second-level sign-in milestones, break reset, and same-second concurrent idempotency.</stringProp>
