    categoryId: (vars.get('categoryId') as Long),
    name: vars.get('xssProductName'),
    subtitle: vars.get('xssPayload'),
    brandName: vars.get('xssPayload'),
    mainImageTempUrl: vars.get('tempUrl'),
    uploadSessionId: vars.get('uploadSessionId'),
    status: 'ACTIVE'
]
vars.put('requestBody', JsonOutput.toJson(body))
