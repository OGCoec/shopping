              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script"><![CDATA[
import groovy.json.JsonSlurper

def body = prev.getResponseDataAsString() ?: ''
try {
    def json = new JsonSlurper().parseText(body)
    vars.put('uploadSessionId', (json.data?.uploadSessionId ?: '').toString())
    vars.put('tempUrl', (json.data?.tempUrl ?: '').toString())
} catch (Throwable ignored) {
}
if ((prev.getResponseCode() ?: '') != '200' || !(vars.get('uploadSessionId') ?: '').trim() || !(vars.get('tempUrl') ?: '').trim()) {
    prev.setSuccessful(false)
    prev.setResponseMessage((prev.getResponseMessage() ?: '') + ' failed to capture uploadSessionId/tempUrl')
}
]]></stringProp>
