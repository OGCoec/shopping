            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script"><![CDATA[
import groovy.json.JsonOutput

def spuId = (props.get('XSS_LAST_SPU_ID') ?: props.get('SPU_ID') ?: '').trim()
def categoryId = (props.get('XSS_LAST_CATEGORY_ID') ?: props.get('CATEGORY_ID') ?: '').trim()
def imageUrl = (vars.get('imageUrl') ?: '/shopping/images/test.png').trim()
def field = (vars.get('fieldName') ?: 'mainImageUrl').trim()
def skuId = (props.get('XSS_LAST_SKU_ID') ?: '').trim()
def skuCode = (props.get('XSS_LAST_SKU_CODE') ?: "safe-${vars.get('caseId')}").take(64)
def skuName = (props.get('XSS_LAST_SKU_NAME') ?: "safe-${vars.get('caseId')}").take(120)

vars.put('spuId', spuId)
def mainImageUrl = field == 'mainImageUrl' ? imageUrl : (props.get('XSS_LAST_MAIN_IMAGE_URL') ?: '/shopping/images/test.png')
def imageUrls = field == 'imageUrls' ? [[url: imageUrl, sort: 1]] : [[url: mainImageUrl, sort: 1]]
def detailImageUrls = field == 'detailImageUrls' ? [[url: imageUrl, sort: 1]] : [[url: mainImageUrl, sort: 1]]
def skuImageUrls = field == 'skuImageUrls' ? [[url: imageUrl, sort: 1]] : [[url: mainImageUrl, sort: 1]]
def sku = [
    skuCode: skuCode,
    skuName: skuName,
    specJson: [safe: true, caseId: vars.get('caseId')],
    skuImageUrls: skuImageUrls,
    priceYuan: 1.00,
    originalPriceYuan: 2.00,
    stockQuantity: 10,
    status: 'ACTIVE'
]
if (skuId) {
    sku.id = skuId
}
def body = [
    categoryId: categoryId as Long,
    name: "xss-safe-image-${vars.get('caseId')}".take(120),
    subtitle: 'safe image url control',
    brandName: 'xss',
    mainImageUrl: mainImageUrl,
    status: 'ACTIVE',
    imageUrls: imageUrls,
    detailImageUrls: detailImageUrls,
    attributes: [caseId: vars.get('caseId'), fieldName: field],
    description: 'safe image url control',
    afterSale: 'safe image url control',
    skus: [sku],
    imageUploadSessions: []
]
vars.put('requestBody', JsonOutput.toJson(body))
]]></stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Safe Image URL Must Be Accepted" enabled="true">
            <stringProp name="cacheKey">xss-safe-image-url-assertion</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script"><![CDATA[
import groovy.json.JsonSlurper

def businessCode = ''
try {
    def json = new JsonSlurper().parseText(prev.getResponseDataAsString() ?: '')
    businessCode = (json.code ?: '').toString()
} catch (Throwable ignored) {
}
if ((prev.getResponseCode() ?: '') != '200' || businessCode != 'ADMIN_OK') {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("Safe image URL was not accepted. caseId=${vars.get('caseId')}, field=${vars.get('fieldName')}, http=${prev.getResponseCode()}, code=${businessCode}")
}
]]></stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
