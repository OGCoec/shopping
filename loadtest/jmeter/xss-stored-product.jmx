            <stringProp name="script"><![CDATA[
import groovy.json.JsonOutput

def spuId = (props.get('XSS_LAST_SPU_ID') ?: props.get('SPU_ID') ?: '').trim()
def categoryId = (props.get('XSS_LAST_CATEGORY_ID') ?: props.get('CATEGORY_ID') ?: '').trim()
def safeImage = (props.get('XSS_LAST_MAIN_IMAGE_URL') ?: props.get('MAIN_IMAGE_URL') ?: '/shopping/images/test.png').trim()
def field = (vars.get('fieldName') ?: '').trim()
def dangerousUrl = vars.get('imageUrl') ?: ''

vars.put('spuId', spuId)
vars.put('categoryId', categoryId)
vars.put('safeImageUrl', safeImage)

def mainImageUrl = field == 'mainImageUrl' ? dangerousUrl : safeImage
def imageUrls = [[url: safeImage, sort: 1]]
def detailImageUrls = [[url: safeImage, sort: 1]]
def skus = []
if (field == 'imageUrls') {
    imageUrls = [[url: dangerousUrl, sort: 1]]
}
if (field == 'detailImageUrls') {
    detailImageUrls = [[url: dangerousUrl, sort: 1]]
}
if (field == 'skuImageUrls') {
    skus = [[
        skuCode: "reject-${vars.get('caseId')}".take(64),
        skuName: "reject-${vars.get('caseId')}".take(120),
        specJson: [caseId: vars.get('caseId')],
        skuImageUrls: [[url: dangerousUrl, sort: 1]],
        priceYuan: 1.00,
        originalPriceYuan: 2.00,
        stockQuantity: 1,
        status: 'ACTIVE'
    ]]
}

def body = [
    categoryId: categoryId as Long,
    name: "xss-image-reject-${vars.get('caseId')}".take(120),
    subtitle: 'dangerous image url rejection',
    brandName: 'xss',
    mainImageUrl: mainImageUrl,
    status: 'ACTIVE',
    imageUrls: imageUrls,
    detailImageUrls: detailImageUrls,
    attributes: [caseId: vars.get('caseId'), fieldName: field],
    description: 'dangerous image url rejection',
    afterSale: 'dangerous image url rejection',
    skus: skus,
    imageUploadSessions: []
]
vars.put('requestBody', JsonOutput.toJson(body))
]]></stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Dangerous Image URL Must Be Rejected" enabled="true">
            <stringProp name="cacheKey">xss-dangerous-image-url-assertion</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script"><![CDATA[
import groovy.json.JsonSlurper

def expectedCode = vars.get('expectedCode') ?: 'ADMIN_PRODUCT_IMAGE_URL_INVALID'
def actualCode = ''
try {
    def json = new JsonSlurper().parseText(prev.getResponseDataAsString() ?: '')
    actualCode = (json.code ?: '').toString()
} catch (Throwable ignored) {
}
if ((prev.getResponseCode() ?: '') == '400' && actualCode == expectedCode) {
    prev.setSuccessful(true)
    prev.setResponseMessage("Dangerous image URL rejected as expected. caseId=${vars.get('caseId')}, field=${vars.get('fieldName')}")
    return
}
if ((prev.getResponseCode() ?: '') != '400' || actualCode != expectedCode) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("Dangerous image URL was not rejected as expected. caseId=${vars.get('caseId')}, field=${vars.get('fieldName')}, http=${prev.getResponseCode()}, code=${actualCode}")
}
]]></stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223Assertion>
