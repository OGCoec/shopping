        <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Stored Flow Safety Assertion" enabled="true">
          <stringProp name="cacheKey">xss-stored-flow-safety</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script"><![CDATA[
import java.util.Locale

def code = (prev.getResponseCode() ?: '0') as int
def label = prev.getSampleLabel() ?: ''
def body = prev.getResponseDataAsString() ?: ''
def contentType = (prev.getContentType() ?: '').toLowerCase(Locale.ROOT)
def lowerBody = body.toLowerCase(Locale.ROOT)

if (code >= 500) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("HTTP ${code} for ${label}, payloadId=${vars.get('payloadId') ?: vars.get('caseId')}")
    return
}

if ((label.startsWith('Admin') || label.startsWith('Create') || label.startsWith('Update') || label.startsWith('Preupload')) &&
        (code == 401 || code == 403 || lowerBody.contains('admin_auth_required'))) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("Admin sampler is unauthenticated. Pass -JADMIN_COOKIE or use run-xss-stored-product.ps1 -AdminCookie.")
    return
}

if (!contentType.contains('json')) {
    def dangerousTokens = ['<script', 'onerror=', 'onload=', 'javascript:alert', 'data:text/html']
    for (def token : dangerousTokens) {
        if (lowerBody.contains(token)) {
            AssertionResult.setFailure(true)
            AssertionResult.setFailureMessage("Executable XSS token '${token}' appeared in non-JSON response from ${label}")
            return
        }
    }
}
]]></stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Assertion>
        <hashTree/>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Initialize Stored XSS Variables" enabled="true">
          <stringProp name="cacheKey">xss-stored-init</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script"><![CDATA[
import java.text.SimpleDateFormat
import java.util.UUID

def adminCookie = (props.get('ADMIN_COOKIE') ?: '').trim()
def categoryId = (props.get('CATEGORY_ID') ?: '').trim()
def suppliedSpuId = (props.get('SPU_ID') ?: '').trim()
def allowExisting = (props.get('ALLOW_UPDATE_EXISTING_SPU') ?: 'false').equalsIgnoreCase('true')
def testImage = (props.get('TEST_IMAGE') ?: 'loadtest/data/xss-test-image.svg').trim()

if (!adminCookie) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseMessage('ADMIN_COOKIE is required for stored XSS admin API tests.')
    return
}
if (!categoryId) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseMessage('CATEGORY_ID is required for stored XSS product update tests.')
    return
}
if (suppliedSpuId && !allowExisting) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseMessage('SPU_ID was provided but ALLOW_UPDATE_EXISTING_SPU=true was not set. Use an isolated test product only.')
    return
}
if (!suppliedSpuId && !new File(testImage).isFile()) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseMessage("TEST_IMAGE does not exist: ${testImage}")
    return
}

def runId = (props.get('RUN_ID') ?: new SimpleDateFormat('yyyyMMddHHmmss').format(new Date())).trim()
def safePayloadId = ((vars.get('payloadId') ?: 'payload') as String).replaceAll('[^A-Za-z0-9_-]', '_')
def suffix = UUID.randomUUID().toString().substring(0, 8)
def unique = "${runId}-${safePayloadId}-${suffix}"
def payload = vars.get('payload') ?: ''

vars.put('categoryId', categoryId)
vars.put('spuId', suppliedSpuId)
vars.put('xssPayload', payload)
vars.put('xssProductName', "xss-product-${unique}".take(120))
vars.put('xssSkuCode', "xss-sku-${unique}".take(64))
vars.put('xssSkuName', "xss-sku-name-${unique}".take(120))
vars.put('mainImageUrl', (props.get('MAIN_IMAGE_URL') ?: '/shopping/images/test.png').trim())
vars.put('safeImageUrl', (props.get('MAIN_IMAGE_URL') ?: '/shopping/images/test.png').trim())
SampleResult.setSuccessful(true)
SampleResult.setResponseMessage("payloadId=${safePayloadId}")
]]></stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Sampler>
