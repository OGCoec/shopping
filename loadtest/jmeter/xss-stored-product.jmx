if ((prev.getResponseCode() ?: '') != '200' || !(vars.get('spuId') ?: '').trim()) {
    prev.setSuccessful(false)
    prev.setResponseMessage((prev.getResponseMessage() ?: '') + ' failed to capture created SPU id')
}
]]></stringProp>
