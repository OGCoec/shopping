          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Capture Created SKU" enabled="true">
            <stringProp name="cacheKey">xss-capture-created-sku</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script"><![CDATA[
import groovy.json.JsonSlurper

def body = prev.getResponseDataAsString() ?: ''
try {
    def json = new JsonSlurper().parseText(body)
    vars.put('skuId', (json.data?.id ?: '').toString())
} catch (Throwable ignored) {
}
if ((prev.getResponseCode() ?: '') != '200' || !(vars.get('skuId') ?: '').trim()) {
    prev.setSuccessful(false)
    prev.setResponseMessage((prev.getResponseMessage() ?: '') + ' failed to capture created SKU id')
} else {
    props.put('XSS_LAST_SPU_ID', vars.get('spuId') ?: '')
    props.put('XSS_LAST_CATEGORY_ID', vars.get('categoryId') ?: '')
    props.put('XSS_LAST_MAIN_IMAGE_URL', vars.get('mainImageUrl') ?: vars.get('safeImageUrl') ?: '')
    props.put('XSS_LAST_SKU_ID', vars.get('skuId') ?: '')
    props.put('XSS_LAST_SKU_CODE', vars.get('xssSkuCode') ?: '')
    props.put('XSS_LAST_SKU_NAME', vars.get('xssSkuName') ?: '')
    def resultFile = (props.get('XSS_RESULT_FILE') ?: '').trim()
    if (resultFile) {
        def file = new File(resultFile)
        file.parentFile?.mkdirs()
        file.text = "spuId=${vars.get('spuId') ?: ''}\ncategoryId=${vars.get('categoryId') ?: ''}\nskuId=${vars.get('skuId') ?: ''}\n"
    }
}
]]></stringProp>
