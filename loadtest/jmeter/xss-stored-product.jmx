def imageUrl = (vars.get('mainImageUrl') ?: vars.get('safeImageUrl') ?: '/shopping/images/test.png').trim()
def body = [
    categoryId: (vars.get('categoryId') as Long),
    name: vars.get('xssProductName'),
    subtitle: vars.get('xssPayload'),
    brandName: vars.get('xssPayload'),
    mainImageUrl: imageUrl,
    status: 'ACTIVE',
    imageUrls: [[url: imageUrl, sort: 1]],
    detailImageUrls: [[url: imageUrl, sort: 1]],
    attributes: [xss: vars.get('xssPayload')],
    description: vars.get('xssPayload'),
    afterSale: vars.get('xssPayload'),
    skus: [],
    imageUploadSessions: []
]
vars.put('requestBody', JsonOutput.toJson(body))
]]></stringProp>
