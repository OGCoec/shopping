            <stringProp name="parameters"></stringProp>
            <stringProp name="script"><![CDATA[
import groovy.json.JsonOutput

def imageUrl = (vars.get('mainImageUrl') ?: vars.get('safeImageUrl') ?: '/shopping/images/test.png').trim()
def body = [
    skuCode: vars.get('xssSkuCode'),
    skuName: vars.get('xssPayload'),
    specJson: [xss: vars.get('xssPayload')],
    skuImageUrls: [[url: imageUrl, sort: 1]],
    priceYuan: 1.00,
    originalPriceYuan: 2.00,
    stockQuantity: 10,
    status: 'ACTIVE',
    imageUploadSessions: []
]
vars.put('requestBody', JsonOutput.toJson(body))
]]></stringProp>
