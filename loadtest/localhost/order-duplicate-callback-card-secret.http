@protocol = http
@host = localhost
@port = 8080

# Generate a real pending order first:
# mvn -q -pl shopping-web exec:java -Dexec.mainClass=com.example.ShoppingSystem.tools.loadtest.OrderDuplicateCallbackCardSecretSeedMain -Dexec.args="1 2 5 loadtest-output/order-duplicate-callback-card-secret-input.csv local-manual false"
#
# Then copy one order_no, external_trade_no, paid_amount_yuan, and payment_provider
# from loadtest-output/order-duplicate-callback-card-secret-input.csv.
@orderNo = REPLACE_WITH_ORDER_NO
@externalTradeNo = REPLACE_WITH_EXTERNAL_TRADE_NO
@paidAmountYuan = 19.80
@paymentProvider = SIMULATED

### duplicate callback 1
POST {{protocol}}://{{host}}:{{port}}/shopping/api/payments/callback/success
Accept: application/json
Content-Type: application/json

{
  "orderNo": "{{orderNo}}",
  "externalTradeNo": "{{externalTradeNo}}",
  "paidAmountYuan": {{paidAmountYuan}},
  "paymentProvider": "{{paymentProvider}}"
}

